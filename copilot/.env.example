# Agent Service configuration. Copy to `.env` for local dev (never commit `.env`).
# Secrets are env-only (phi-and-secrets rule).

# HTTP server
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Redis (Patient Snapshot cache)
REDIS_URL=redis://127.0.0.1:6379

# OpenEMR API (read path). Local dev reuses docker/development-easy; use the https
# port (9300) — OpenEMR's advertised OAuth issuer/token endpoint is https.
OPENEMR_BASE_URL=https://localhost:9300
# Readiness probe timeout — generous for the slow dev container; tighten in prod.
OPENEMR_PROBE_TIMEOUT_MS=8000
# DEV ONLY: accept the local self-signed cert. NEVER set true in production.
OPENEMR_INSECURE_TLS=true

# OpenEMR OAuth2 client (SMART backend-services: client_credentials + private_key_jwt).
# Register with: pnpm --filter @copilot/openemr-client register
# It writes client_id + private key to copilot/.secrets/ (git-ignored).

# Anthropic (LLM provider). Required for the /chat agent and the anthropic /ready
# check. Put your key here (this file's .env copy is git-ignored).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Week 2: multimodal document ingestion + guideline RAG ---
# Cohere (embed + rerank for guideline RAG). This is the ONE external egress in the
# system (non-PHI guideline text + the query only — see docs/w2-privacy-audit.md).
# Unset => the agent falls back to a deterministic offline bag-of-words embedder, so
# retrieval and the eval gate still run (only paraphrase-quality retrieval degrades).
COHERE_API_KEY=
# Claude VISION model used to extract fields from lab PDFs / intake forms.
COPILOT_VLM_MODEL=claude-opus-4-8

# Verification layer 2 — grounding judge. Opt-in (adds one cheap LLM call per claim
# to confirm each cited row actually SUPPORTS the claim). Off by default to keep cost
# down; enable for the full faithfulness gate. Uses a small model (Haiku).
COPILOT_GROUNDING_JUDGE=false
COPILOT_GROUNDING_MODEL=claude-haiku-4-5

# Supervisor routing model (W2). Routing is a narrow typed classification, not generation, so it
# defaults to Haiku — far faster + cheaper than the generation model, cutting the per-turn latency
# the supervisor adds. Override only if a routing case needs a stronger model.
COPILOT_SUPERVISOR_MODEL=claude-haiku-4-5

# Langfuse (self-hosted observability). Matches docker-compose.yml LANGFUSE_INIT_*.
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_PUBLIC_KEY=pk-lf-copilot-dev
LANGFUSE_SECRET_KEY=sk-lf-copilot-dev

# Boundary-#1 session-token secret (HMAC-SHA256), shared with the OpenEMR mint
# bridge. The pid the agent operates on comes from a token signed with this secret,
# never from the request body (authorization-and-pid-scope rule). REQUIRED for /chat:
# if unset, every /chat request is refused with 401 (fail-closed).
COPILOT_BRIDGE_SECRET=

# DEV ONLY: enable GET /dev/session-token, a local mint stand-in for the OpenEMR
# bridge so the dev chat page / evals / API collection can obtain a token without
# the PHP module. It does NOT check ownership. This file is a LOCAL-DEV template, so it
# defaults to true; the agent hard-disables it whenever NODE_ENV=production regardless,
# so this value can never expose the ownership bypass in a prod deploy.
COPILOT_DEV_MINT=true

# Exact OpenEMR app origin allowed to call /chat cross-origin from the embedded chat
# UI (the oe-module-copilot page lives on the OpenEMR origin; the agent is a separate
# origin). Unset => no CORS headers. Local dev example: https://localhost:9300
COPILOT_ALLOWED_ORIGIN=https://localhost:9300

# Bearer token gating the operations surfaces: GET /metrics (JSON), GET /dashboard
# (HTML), GET /alerts (E4 + E7). If unset, none of those routes are registered
# (fail-closed) — set it to view the dashboard or evaluate alerts. No PHI is exposed
# by these routes, but they reveal traffic volume and error posture, so they are gated.
# The dashboard also accepts it as a ?token= query param for browser viewing.
COPILOT_METRICS_TOKEN=
