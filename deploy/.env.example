# Copy to .env on the droplet and fill in. NEVER commit .env (see .gitignore).
#
# Public hostname Caddy provisions certs for. Use any domain you control —
# e.g. SITE_ADDRESS=emr.example.com (the agent and Langfuse are then served at
# copilot.emr.example.com and langfuse.emr.example.com).
#
# No domain? sslip.io is wildcard DNS that resolves <ip-with-dashes>.sslip.io to
# that IP, so a bare host works with no DNS setup:
#   for 203.0.113.10 -> SITE_ADDRESS=203-0-113-10.sslip.io
SITE_ADDRESS=CHANGEME.example.com

# Strong secrets. Generate each with:  openssl rand -hex 24
MYSQL_ROOT_PASSWORD=CHANGEME
MYSQL_PASSWORD=CHANGEME
OE_ADMIN_PASSWORD=CHANGEME

# GitHub token so `composer install` doesn't hit API rate limits during the
# first-boot build. A classic PAT with NO scopes is enough (just raises the
# rate limit). Optional — leave blank to try without; add one if the build
# fails on GitHub rate limits.
GITHUB_COMPOSER_TOKEN=

# --- Clinical Co-Pilot sidecar ---------------------------------------------
# Anthropic PROD key. Create a dedicated key (ideally its own workspace with a
# spend limit) and place it here ON THE BOX ONLY — never commit, never paste it
# into a chat. See deploy/README.md for the no-echo one-liner.
ANTHROPIC_API_KEY=

# Boundary-#1 HMAC secret shared between the OpenEMR mint bridge (oe-module-copilot)
# and the agent. Both services below read this; they MUST match. Generate with:
#   openssl rand -hex 32
COPILOT_BRIDGE_SECRET=CHANGEME

# Langfuse (self-hosted observability). Generate each secret with:
#   openssl rand -hex 32     (ENCRYPTION_KEY must be exactly 64 hex chars)
LANGFUSE_DB_PASSWORD=CHANGEME
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME_64_hex_chars
# Project API keys — the agent sends traces with these (must match the values
# Langfuse seeds via LANGFUSE_INIT_PROJECT_*). Public key is not secret; secret is.
LANGFUSE_PUBLIC_KEY=pk-lf-copilot-prod
LANGFUSE_SECRET_KEY=CHANGEME
# Langfuse admin login (to view the dashboard at https://langfuse.<SITE_ADDRESS>).
LANGFUSE_USER_EMAIL=admin@copilot.local
LANGFUSE_USER_PASSWORD=CHANGEME
